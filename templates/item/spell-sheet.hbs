<div class="antique sheet item spell">
  <header class="sheet-header">
    <img class="item-img" src="{{item.img}}" data-edit="img" data-action="editImage" title="{{item.name}}" />
    <h1 class="item-name"><input name="name" type="text" value="{{item.name}}" /></h1>
  </header>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="description">{{localize "ANTIQUE.Tab.Description"}}</a>
    <a class="item" data-tab="ingredients">{{localize "ANTIQUE.Tab.Ingredients"}} ({{system.ingredients.length}})</a>
    <a class="item" data-tab="effects">{{localize "ANTIQUE.Tab.Effects"}} ({{effects.length}})</a>
  </nav>

  <section class="sheet-body">

    {{!-- Description Tab --}}
    <div class="tab" data-group="primary" data-tab="description">
      <div class="form-group">
        <label>{{localize "ANTIQUE.Spell.Effect"}}</label>
        <input type="text" name="system.effect" value="{{system.effect}}" />
      </div>
      <div class="form-group">
        <label>{{localize "ANTIQUE.Spell.Ritual"}}</label>
        <input type="checkbox" name="system.ritual" {{#if system.ritual}}checked{{/if}} />
      </div>
      {{#if system.ritual}}
      <div class="form-group">
        <label>{{localize "ANTIQUE.Spell.CostText"}}</label>
        <input type="text" name="system.costText" value="{{system.costText}}" />
      </div>
      {{else}}
      <div class="form-group">
        <label>{{localize "ANTIQUE.Spell.Cost"}}</label>
        <input type="number" name="system.cost" value="{{system.cost}}" />
      </div>
      {{/if}}
      <div class="form-group">
        <label>{{localize "ANTIQUE.Spell.Limitation"}}</label>
        <div class="limitation-fields">
          <input type="number" name="system.limitation" value="{{system.limitation}}" min="0" />
          {{#if (gt system.limitation 0)}}
          <span class="limitation-counter">{{system.limitationValue}} / {{system.limitation}}</span>
          {{else}}
          <span class="limitation-counter">{{localize "ANTIQUE.Spell.Unlimited"}}</span>
          {{/if}}
        </div>
      </div>
      <div class="form-group">
        <label>{{localize "ANTIQUE.Spell.Range"}}</label>
        <input type="text" name="system.range" value="{{system.range}}" />
      </div>
      <div class="form-group">
        <label>{{localize "ANTIQUE.Spell.Duration"}}</label>
        <input type="text" name="system.duration" value="{{system.duration}}" />
      </div>
      <div class="form-group">
        <label>{{localize "ANTIQUE.Spell.Components"}}</label>
        <input type="text" name="system.components" value="{{system.components}}" />
      </div>
      <div class="form-group">
        <label>{{localize "ANTIQUE.Spell.CaBonus"}}</label>
        <input type="number" name="system.caBonus" value="{{system.caBonus}}" />
        <span class="cout-hint">{{localize "ANTIQUE.Spell.CaBonusHint"}}</span>
      </div>
      <div class="form-group">
        <label>
          <input type="checkbox" name="system.hasTemplate" {{#if system.hasTemplate}}checked{{/if}} />
          {{localize "ANTIQUE.Spell.HasTemplate"}}
        </label>
        <span class="cout-hint">{{localize "ANTIQUE.Spell.HasTemplateHint"}}</span>
      </div>
      {{#if system.hasTemplate}}
      <div class="form-group">
        <label>{{localize "ANTIQUE.Spell.TemplateRadius"}}</label>
        <input type="number" name="system.templateRadius" value="{{system.templateRadius}}" min="1" />
      </div>
      <div class="form-group">
        <label>{{localize "ANTIQUE.Spell.TemplateTexture"}}</label>
        <input type="text" name="system.templateTexture" value="{{system.templateTexture}}" title="{{localize 'ANTIQUE.Spell.TemplateTextureHint'}}" />
      </div>
      <div class="form-group">
        <label>{{localize "ANTIQUE.Spell.TemplateColor"}}</label>
        <input type="color" name="system.templateColor" value="{{system.templateColor}}" />
      </div>
      {{/if}}
      <div class="form-group description">
        <label>{{localize "ANTIQUE.Description"}}</label>
        {{richEditor "system.description" system.description editable=isEditable}}
      </div>
      {{#if isGM}}
      <div class="gm-notes-section">
        <h3><i class="fas fa-eye-slash"></i> {{localize "ANTIQUE.GmNotes.Title"}}</h3>
        <div class="gm-notes-editor">
          {{richEditor "system.gmNotes" system.gmNotes editable=isEditable}}
        </div>
      </div>
      {{/if}}
    </div>

    {{!-- Ingredients Tab --}}
    <div class="tab" data-group="primary" data-tab="ingredients">
      <div class="effects-header">
        <h3>{{localize "ANTIQUE.Ingredients.Title"}}</h3>
        {{#if isEditable}}
        <a class="ingredient-create"><i class="fas fa-plus"></i> {{localize "ANTIQUE.Ingredients.Add"}}</a>
        {{/if}}
      </div>

      {{#if system.ingredients.length}}
      <ol class="ingredients-list">
        {{#each system.ingredients as |ing|}}
        <li class="ingredient-row" data-ingredient-id="{{ing.id}}">
          <input type="checkbox" class="ingredient-possede-checkbox" {{#if ing.possede}}checked{{/if}}
                 title="{{localize 'ANTIQUE.Ingredients.Possede'}}" {{#unless ../isEditable}}disabled{{/unless}} />
          <input type="text" class="ingredient-name-input" value="{{ing.name}}"
                 placeholder="{{localize 'ANTIQUE.Ingredients.Name'}}" {{#unless ../isEditable}}disabled{{/unless}} />
          <input type="number" class="ingredient-quantity-input" value="{{ing.quantity}}" min="0"
                 {{#unless ../isEditable}}disabled{{/unless}} />
          {{#with (lookup ../ingredientStock ing.id) as |stock|}}
          <span class="ingredient-stock-hint {{#if stock.insufficient}}insufficient{{/if}}">{{stock.label}}</span>
          {{/with}}
          {{#if ../isEditable}}
          <a class="ingredient-delete" title="{{localize 'ANTIQUE.Ingredients.Delete'}}"><i class="fas fa-trash"></i></a>
          {{/if}}
        </li>
        {{/each}}
      </ol>
      {{else}}
      <p class="effects-empty">{{localize "ANTIQUE.Ingredients.Empty"}}</p>
      {{/if}}
    </div>

    {{!-- Effects Tab --}}
    <div class="tab" data-group="primary" data-tab="effects">
      <div class="effects-header">
        <h3>{{localize "ANTIQUE.Effects.Title"}}</h3>
        <a class="effect-create"><i class="fas fa-plus"></i> {{localize "ANTIQUE.Effects.Add"}}</a>
      </div>

      {{#if hasEffects}}
      <ol class="effects-list">
        {{#each effects as |effect|}}
        <li class="effect-row {{#if effect.disabled}}disabled{{/if}}" data-effect-id="{{effect.id}}">
          <img class="effect-icon" src="{{effect.icon}}" width="24" height="24" />
          <div class="effect-info">
            <span class="effect-name">{{effect.name}}</span>
            <span class="effect-changes-list">
              {{#each effect.changes as |change|}}
              <span class="effect-change-badge advantage">{{change.label}}</span>
              {{/each}}
              {{#unless effect.changesCount}}
              <span class="effect-change-badge empty">Aucune modification</span>
              {{/unless}}
            </span>
          </div>
          <div class="effect-controls">
            <a class="effect-toggle" title="{{#if effect.disabled}}{{localize 'ANTIQUE.Effects.Disabled'}}{{else}}{{localize 'ANTIQUE.Effects.Active'}}{{/if}}">
              <i class="fas {{#if effect.disabled}}fa-times-circle{{else}}fa-check-circle{{/if}}"></i>
            </a>
            <a class="effect-edit" title="Edit"><i class="fas fa-edit"></i></a>
            <a class="effect-delete" title="Delete"><i class="fas fa-trash"></i></a>
          </div>
        </li>
        {{/each}}
      </ol>
      {{else}}
      <p class="effects-empty">{{localize "ANTIQUE.Effects.NoEffects"}}</p>
      {{/if}}
    </div>

  </section>
</div>
