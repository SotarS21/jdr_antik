<div class="antique sheet item equipment">
  <header class="sheet-header">
    <img class="item-img" src="{{item.img}}" data-edit="img" data-action="editImage" title="{{item.name}}" />
    <h1 class="item-name"><input name="name" type="text" value="{{item.name}}" /></h1>
  </header>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="description">{{localize "ANTIQUE.Tab.Description"}}</a>
    <a class="item" data-tab="effects">{{localize "ANTIQUE.Tab.Effects"}} ({{effects.length}})</a>
  </nav>

  <section class="sheet-body">

    {{!-- Description Tab --}}
    <div class="tab" data-group="primary" data-tab="description">
      <div class="form-group">
        <label>{{localize "ANTIQUE.Equipment.Quantity"}}</label>
        <input type="number" name="system.quantity" value="{{system.quantity}}" />
      </div>
      <div class="form-group">
        <label>{{localize "ANTIQUE.Equipment.Price"}}</label>
        <input type="text" name="system.price" value="{{system.price}}" />
      </div>
      <div class="form-group">
        <label>
          <input type="checkbox" name="system.consumable" {{#if system.consumable}}checked{{/if}} />
          {{localize "ANTIQUE.Item.Consumable"}}
        </label>
      </div>
      <div class="form-group">
        <label>{{localize "ANTIQUE.Equipment.Slot"}}</label>
        <select name="system.slot">
          <option value="">{{localize "ANTIQUE.Equipment.NoSlot"}}</option>
          {{#each slotOptions as |opt|}}
          <option value="{{opt.key}}" {{#ifEquals opt.key @root.system.slot}}selected{{/ifEquals}}>{{opt.label}}</option>
          {{/each}}
        </select>
      </div>
      {{#if system.slot}}
      <div class="form-group">
        <label>
          <input type="checkbox" name="system.equipped" {{#if system.equipped}}checked{{/if}} />
          {{localize "ANTIQUE.Equipment.Equipped"}}
        </label>
      </div>
      {{/if}}
      <div class="form-group">
        <label>{{localize "ANTIQUE.Equipment.CaBonus"}}</label>
        <input type="number" name="system.caBonus" value="{{system.caBonus}}" title="{{localize 'ANTIQUE.Equipment.CaBonusHint'}}" />
      </div>
      <div class="form-group">
        <label>{{localize "ANTIQUE.Equipment.LinkedSkill"}}</label>
        <select name="system.linkedSkill">
          <option value="">{{localize "ANTIQUE.Equipment.NoSkillBonus"}}</option>
          {{#each skillOptions as |opt|}}
          <option value="{{opt.key}}" {{#ifEquals opt.key @root.system.linkedSkill}}selected{{/ifEquals}}>{{opt.label}}</option>
          {{/each}}
        </select>
      </div>
      {{#if system.linkedSkill}}
      <div class="form-group">
        <label>{{localize "ANTIQUE.Equipment.SkillBonus"}}</label>
        <input type="number" name="system.skillBonus" value="{{system.skillBonus}}" />
      </div>
      {{/if}}
      <div class="form-group">
        <label>{{localize "ANTIQUE.Equipment.ApothCategory"}}</label>
        <select name="system.apothCategory">
          <option value="">{{localize "ANTIQUE.Equipment.NoApothCategory"}}</option>
          {{#each apothCategoryOptions as |opt|}}
          <option value="{{opt.key}}" {{#ifEquals opt.key @root.system.apothCategory}}selected{{/ifEquals}}>{{opt.label}}</option>
          {{/each}}
        </select>
      </div>
      {{#if system.apothCategory}}
      <div class="form-group">
        <label>{{localize "ANTIQUE.Equipment.ApothType"}}</label>
        <input type="text" name="system.apothType" value="{{system.apothType}}" title="{{localize 'ANTIQUE.Equipment.ApothTypeHint'}}" />
      </div>
      {{/if}}
      <div class="form-group description">
        <label>{{localize "ANTIQUE.Description"}}</label>
        {{richEditor "system.description" system.description editable=isEditable}}
      </div>
      {{#if isGM}}
      <div class="gm-notes-section">
        <h3><i class="fas fa-eye-slash"></i> {{localize "ANTIQUE.GmNotes.Title"}}</h3>
        <div class="gm-notes-editor">
          {{richEditor "system.gmNotes" system.gmNotes editable=isEditable}}
        </div>
      </div>
      {{/if}}
    </div>

    {{!-- Effects Tab --}}
    <div class="tab" data-group="primary" data-tab="effects">
      <div class="effects-header">
        <h3>{{localize "ANTIQUE.Effects.Title"}}</h3>
        <a class="effect-create"><i class="fas fa-plus"></i> {{localize "ANTIQUE.Effects.Add"}}</a>
      </div>

      {{#if hasEffects}}
      <ol class="effects-list">
        {{#each effects as |effect|}}
        <li class="effect-row {{#if effect.disabled}}disabled{{/if}}" data-effect-id="{{effect.id}}">
          <img class="effect-icon" src="{{effect.icon}}" width="24" height="24" />
          <div class="effect-info">
            <span class="effect-name">{{effect.name}}</span>
            <span class="effect-changes-list">
              {{#each effect.changes as |change|}}
              <span class="effect-change-badge advantage">{{change.label}}</span>
              {{/each}}
              {{#unless effect.changesCount}}
              <span class="effect-change-badge empty">Aucune modification</span>
              {{/unless}}
            </span>
          </div>
          <div class="effect-controls">
            <a class="effect-toggle" title="{{#if effect.disabled}}{{localize 'ANTIQUE.Effects.Disabled'}}{{else}}{{localize 'ANTIQUE.Effects.Active'}}{{/if}}">
              <i class="fas {{#if effect.disabled}}fa-times-circle{{else}}fa-check-circle{{/if}}"></i>
            </a>
            <a class="effect-edit" title="Edit"><i class="fas fa-edit"></i></a>
            <a class="effect-delete" title="Delete"><i class="fas fa-trash"></i></a>
          </div>
        </li>
        {{/each}}
      </ol>
      {{else}}
      <p class="effects-empty">{{localize "ANTIQUE.Effects.NoEffects"}}</p>
      {{/if}}
    </div>

  </section>
</div>
