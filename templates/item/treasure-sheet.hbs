<div class="antique sheet item treasure">
  <header class="sheet-header">
    <img class="item-img" src="{{item.img}}" data-edit="img" data-action="editImage" title="{{item.name}}" />
    <h1 class="item-name"><input name="name" type="text" value="{{item.name}}" /></h1>
  </header>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="description">{{localize "ANTIQUE.Tab.Description"}}</a>
    <a class="item" data-tab="details">{{localize "ANTIQUE.Tab.Details"}}</a>
  </nav>

  <section class="sheet-body">

    {{!-- Description Tab --}}
    <div class="tab" data-group="primary" data-tab="description">
      <div class="form-group description">
        <label>{{localize "ANTIQUE.Description"}}</label>
        {{richEditor "system.description" system.description editable=isEditable}}
      </div>
      {{#if isGM}}
      <div class="gm-notes-section">
        <h3><i class="fas fa-eye-slash"></i> {{localize "ANTIQUE.GmNotes.Title"}}</h3>
        <div class="gm-notes-editor">
          {{richEditor "system.gmNotes" system.gmNotes editable=isEditable}}
        </div>
      </div>
      {{/if}}
    </div>

    {{!-- Details Tab --}}
    <div class="tab" data-group="primary" data-tab="details">
      <div class="form-group">
        <label>{{localize "ANTIQUE.Equipment.Quantity"}}</label>
        <input type="number" name="system.quantity" value="{{system.quantity}}" />
      </div>
      <div class="form-group">
        <label>{{localize "ANTIQUE.Equipment.Price"}}</label>
        <input type="text" name="system.price" value="{{system.price}}" />
      </div>
      <div class="form-group">
        <label>{{localize "ANTIQUE.Equipment.Poids"}}</label>
        <input type="number" step="0.1" name="system.poids" value="{{system.poids}}" />
      </div>
    </div>

  </section>
</div>
