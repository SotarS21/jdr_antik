<div class="antique sheet actor deity">

  <div class="deity-content">

    {{!-- Portrait --}}
    <div class="deity-portrait-wrapper">
      <img class="deity-portrait" src="{{actor.img}}" data-edit="img" data-action="editImage" title="{{actor.name}}" />
    </div>

    {{!-- Name --}}
    <h1 class="deity-name">
      <input name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'ANTIQUE.Deity.Name'}}" />
    </h1>

    {{!-- Decorative Separator --}}
    <div class="deity-separator">
      <span class="deity-separator-line"></span>
      <span class="deity-separator-icon"><i class="fas fa-sun"></i></span>
      <span class="deity-separator-line"></span>
    </div>

    {{!-- Description --}}
    <div class="deity-description">
      {{richEditor "system.description" system.description editable=isEditable}}
    </div>

  </div>

</div>
