<div class="antique sheet actor npc">

  {{!-- Header --}}
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" data-action="editImage" title="{{actor.name}}" />
    <div class="header-fields">
      <h1 class="charname">
        <input name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'ANTIQUE.Npc.Name'}}" />
      </h1>
      {{#if isGM}}
      <div class="header-row">
        <div class="field">
          <label>{{localize "ANTIQUE.Npc.Type"}}</label>
          <input type="text" name="system.type" value="{{system.type}}" placeholder="Humain, Créature, Divinité..." />
        </div>
        <div class="field">
          <label>{{localize "ANTIQUE.Identity.Taille"}}</label>
          <input type="text" name="system.taille" value="{{system.taille}}" />
        </div>
      </div>
      {{/if}}
      {{#if isGM}}
      <div class="pv-bar">
        <label>{{localize "ANTIQUE.PV"}}</label>
        <input type="number" name="system.pv.value" value="{{pvSource.value}}" class="pv-current" />
        <span>/</span>
        <input type="number" name="system.pv.max" value="{{pvSource.max}}" class="pv-max" />
      </div>
      {{#if system.isMagicPractitioner}}
      <div class="pm-bar">
        <label>{{localize "ANTIQUE.PM"}}</label>
        <input type="number" name="system.pm.value" value="{{pmSource.value}}" class="pm-current" />
        <span>/</span>
        <input type="number" name="system.pm.max" value="{{pmSource.max}}" class="pm-max" />
      </div>
      {{/if}}
      {{/if}}
    </div>
  </header>

  {{!-- Tabs --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    {{#if hasFullAccess}}
    <a class="item" data-tab="stats">{{localize "ANTIQUE.Npc.Tab.Stats"}}</a>
    {{#if isGM}}
    <a class="item" data-tab="combat">{{localize "ANTIQUE.Tab.Combat"}}</a>
    {{/if}}
    <a class="item" data-tab="inventory">{{localize "ANTIQUE.Tab.Inventory"}}</a>
    {{#if system.isMagicPractitioner}}
    <a class="item" data-tab="magic">{{localize "ANTIQUE.Tab.Magic"}}</a>
    {{/if}}
    {{/if}}
    <a class="item" data-tab="notes">{{localize "ANTIQUE.Npc.Tab.Notes"}}</a>
  </nav>

  {{!-- Body --}}
  <section class="sheet-body">

    {{!-- ===================== STATS TAB ===================== --}}
    {{#if hasFullAccess}}
    <div class="tab" data-group="primary" data-tab="stats">
      <div class="npc-abilities-grid">
        {{#each system.abilities as |ability key|}}
        <div class="ability-block">
          <h3 class="ability-label ability-roll" data-ability="{{key}}">
            {{lookup @root.abilityLabels key}}
          </h3>
          <div class="ability-score">
            <input type="number" name="system.abilities.{{key}}.value" value="{{ability.value}}" />
          </div>
          <div class="ability-mod">
            <span class="ability-mod-value">{{signedNum ability.mod}}</span>
          </div>
        </div>
        {{/each}}
      </div>

      {{!-- Quick combat stats --}}
      <div class="npc-combat-quick">
        <div class="npc-stat-box">
          <label>{{localize "ANTIQUE.Combat.CA"}}</label>
          {{#if isGM}}
          <input type="number" name="system.ca.value" value="{{system.ca.value}}" class="npc-big-input" />
          {{else}}
          <div class="npc-big-input npc-ca-hidden" title="{{localize 'ANTIQUE.Combat.CAHiddenFromPlayers'}}"><i class="fas fa-eye-slash"></i></div>
          {{/if}}
        </div>
        <div class="npc-stat-box npc-rollable initiative-roll" title="Lancer l'initiative (1d20 + {{system.initiative.value}})">
          <label><i class="fas fa-dice-d20"></i> {{localize "ANTIQUE.Combat.Initiative"}}</label>
          <input type="number" name="system.initiative.value" value="{{system.initiative.value}}" class="npc-big-input" />
        </div>
        <div class="npc-stat-box npc-rollable attaque-roll" title="Jet d'attaque (1d20 + {{system.attaque.value}})">
          <label><i class="fas fa-fist-raised"></i> {{localize "ANTIQUE.Npc.Attaque"}}</label>
          <input type="number" name="system.attaque.value" value="{{system.attaque.value}}" class="npc-big-input" />
        </div>
      </div>

      {{!-- Description --}}
      <div class="npc-description">
        <label>{{localize "ANTIQUE.Description"}}</label>
        {{richEditor "system.description" system.description editable=isEditable}}
      </div>
    </div>

    {{!-- ===================== COMBAT TAB ===================== --}}
    {{!-- GM-only: never rendered at all for a non-GM (even one who owns/controls this
         token), unlike the Stats tab which stays open to any owner. --}}
    {{#if isGM}}
    <div class="tab" data-group="primary" data-tab="combat">
      {{!-- Quick combat stats — same underlying fields as the Stats tab's quick block,
           but WITHOUT a `name` attribute: this tab renders alongside the Stats tab in
           the same <form>, so a duplicate `name` would make Foundry's form submission
           read a NodeList instead of a single value (validation error on submit from
           EITHER tab). Edited here via a dedicated `data-field` + change listener
           (npc-sheet.mjs) that calls actor.update() directly instead of relying on
           the shared form submit. --}}
      <div class="npc-combat-quick">
        <div class="npc-stat-box">
          <label>{{localize "ANTIQUE.Combat.CA"}}</label>
          <input type="number" data-field="system.ca.value" value="{{system.ca.value}}" class="npc-big-input" />
        </div>
        <div class="npc-stat-box npc-rollable initiative-roll" title="Lancer l'initiative (1d20 + {{system.initiative.value}})">
          <label><i class="fas fa-dice-d20"></i> {{localize "ANTIQUE.Combat.Initiative"}}</label>
          <input type="number" data-field="system.initiative.value" value="{{system.initiative.value}}" class="npc-big-input" />
        </div>
        <div class="npc-stat-box">
          <label><i class="fas fa-shoe-prints"></i> {{localize "ANTIQUE.Identity.Deplacement"}}</label>
          <input type="number" data-field="system.deplacement" value="{{system.deplacement}}" class="npc-big-input" />
        </div>
        {{!-- Esquive/Parade: reactive rolls, -1 temp penalty per use (stacks this
             turn), reset at the start of this actor's next turn (dodge-reset.mjs).
             Input edits the base value; the roll (click anywhere but the input)
             uses the derived total, which reflects any currently stacked penalty. --}}
        <div class="npc-stat-box npc-rollable dodge-roll" data-skill="esquive" title="{{localize 'ANTIQUE.Dodge.Hint'}} (1d20 + {{system.esquive.total}})">
          <label><i class="fas fa-running"></i> {{localize "ANTIQUE.Skill.Esquive"}}</label>
          <input type="number" data-field="system.esquive.value" value="{{system.esquive.value}}" class="npc-big-input" />
        </div>
        <div class="npc-stat-box npc-rollable dodge-roll" data-skill="parade" title="{{localize 'ANTIQUE.Dodge.Hint'}} (1d20 + {{system.parade.total}})">
          <label><i class="fas fa-shield-alt"></i> {{localize "ANTIQUE.Skill.Parade"}}</label>
          <input type="number" data-field="system.parade.value" value="{{system.parade.value}}" class="npc-big-input" />
        </div>
        <div class="npc-stat-box npc-rollable attaque-roll" title="Jet d'attaque (1d20 + {{system.attaque.value}})">
          <label><i class="fas fa-fist-raised"></i> {{localize "ANTIQUE.Npc.Attaque"}}</label>
          <input type="number" data-field="system.attaque.value" value="{{system.attaque.value}}" class="npc-big-input" />
        </div>
      </div>

      {{!-- Attack Bonuses --}}
      <div class="attack-bonuses">
        <h2>{{localize "ANTIQUE.Combat.AttackBonuses"}}</h2>
        <table class="attack-table">
          <thead>
            <tr>
              <th>{{localize "ANTIQUE.Combat.Category"}}</th>
              <th>{{localize "ANTIQUE.Saves.Total"}}</th>
            </tr>
          </thead>
          <tbody>
            {{#each weaponCatsData as |cat key|}}
            <tr>
              <td class="clickable attack-cat-roll" data-cat="{{cat.key}}">{{#if cat.icon}}<i class="{{cat.icon}}"></i> {{/if}}{{cat.label}}</td>
              <td><input type="number" name="system.attackBonuses.{{cat.key}}.total" value="{{cat.total}}" /></td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>

      {{!-- Weapons --}}
      <div class="weapons-section">
        <h2>{{localize "ANTIQUE.Combat.Weapons"}}
          <a class="item-create" data-type="weapon" title="{{localize 'ANTIQUE.Item.Create'}}"><i class="fas fa-plus"></i></a>
        </h2>
        <table class="item-list weapons-list">
          <thead>
            <tr>
              <th class="weapon-img-col"></th>
              <th>{{localize "ANTIQUE.Weapon.Name"}}</th>
              <th>{{localize "ANTIQUE.Weapon.AttBonus"}}</th>
              <th>{{localize "ANTIQUE.Weapon.AttBonusDistance"}}</th>
              <th>{{localize "ANTIQUE.Weapon.Damage"}}</th>
              <th>{{localize "ANTIQUE.Weapon.Critical"}}</th>
              <th>{{localize "ANTIQUE.Weapon.Type"}}</th>
              <th>{{localize "ANTIQUE.Weapon.Portee"}}</th>
              <th>{{localize "ANTIQUE.Item.Consumable"}}</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {{#each weapons as |weapon|}}
            <tr class="item" data-item-id="{{weapon.id}}">
              <td class="weapon-img item-chat" title="{{localize 'ANTIQUE.Item.PostToChat'}}"><img src="{{weapon.img}}" width="24" height="24" /></td>
              <td class="weapon-name clickable weapon-attack">{{weapon.name}}</td>
              <td class="clickable weapon-attack">{{weapon.attTotal}}</td>
              <td class="clickable weapon-attack">{{#if weapon.system.hasPortee}}{{weapon.attTotalDistance}}{{else}}—{{/if}}</td>
              <td class="clickable weapon-damage">{{weapon.system.damage}}</td>
              <td>{{weapon.system.critical}}</td>
              <td>{{weapon.system.typeDamage}}</td>
              <td>{{#if weapon.system.hasPortee}}{{weapon.system.portee}} m{{else}}—{{/if}}</td>
              <td class="munitions-cell">
                {{#if weapon.system.consumable}}
                  {{#if weapon.linkedAmmoName}}
                  <span class="linked-ammo-badge" title="{{weapon.linkedAmmoName}}">
                    <i class="fas fa-link"></i>
                    <span class="munitions-value {{#if (lt weapon.linkedAmmoQty 1)}}empty{{/if}}">{{weapon.linkedAmmoQty}}</span>
                    <span class="linked-ammo-name">{{weapon.linkedAmmoName}}</span>
                  </span>
                  {{else}}
                  <select class="munitions-select">
                    <option value="">{{localize "ANTIQUE.Munitions.Choose"}}</option>
                    {{#each ../ammoCandidates as |ammo|}}
                    <option value="{{ammo.id}}">{{ammo.name}}</option>
                    {{/each}}
                  </select>
                  {{/if}}
                  <a class="item-consume" title="{{localize 'ANTIQUE.Consume.Munition'}}"><i class="fas fa-arrow-down"></i></a>
                {{else}}
                —
                {{/if}}
              </td>
              <td class="item-controls">
                <a class="item-edit"><i class="fas fa-edit"></i></a>
                <a class="item-delete"><i class="fas fa-trash"></i></a>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>

      {{!-- Combat Abilities (item type "npcability") --}}
      <div class="traits-section">
        <h2>{{localize "ANTIQUE.Combat.NpcAbilities"}}
          <a class="item-create" data-type="npcability" title="{{localize 'ANTIQUE.Item.Create'}}"><i class="fas fa-plus"></i></a>
        </h2>
        <table class="item-list traits-table">
          <thead>
            <tr>
              <th class="trait-img-col"></th>
              <th>{{localize "ANTIQUE.Traits.TraitName"}}</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {{#each npcAbilities as |ab|}}
            <tr class="item trait-row" data-item-id="{{ab.id}}">
              <td class="trait-img item-chat" title="{{localize 'ANTIQUE.Item.PostToChat'}}"><img src="{{ab.img}}" width="24" height="24" /></td>
              <td class="trait-name item-chat clickable" title="{{localize 'ANTIQUE.Item.PostToChat'}}"><i class="fas fa-caret-right trait-toggle-icon"></i> {{ab.name}}</td>
              <td class="item-controls">
                <a class="item-edit"><i class="fas fa-edit"></i></a>
                <a class="item-delete"><i class="fas fa-trash"></i></a>
              </td>
            </tr>
            <tr class="trait-detail-row" data-item-id="{{ab.id}}">
              <td colspan="3">
                <div class="trait-detail-content">
                  {{{ab.system.description}}}
                  {{#if ab.hasEffects}}
                  <div class="trait-effects-list"><strong>{{localize "ANTIQUE.Traits.Effect"}} :</strong> {{ab.effectsSummary}}</div>
                  {{/if}}
                </div>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>

    </div>
    {{/if}}

    {{!-- ===================== INVENTORY TAB ===================== --}}
    <div class="tab" data-group="primary" data-tab="inventory">
      <div class="currency-section">
        <label>{{localize "ANTIQUE.Currency.Or"}}</label>
        <input type="number" name="system.or" value="{{system.or}}" />
      </div>

      <div class="equipment-section">
        <h2>{{localize "ANTIQUE.Inventory.Equipment"}}
          <a class="item-create" data-type="equipment" title="{{localize 'ANTIQUE.Item.Create'}}"><i class="fas fa-plus"></i></a>
        </h2>
        <table class="item-list">
          <thead>
            <tr>
              <th>{{localize "ANTIQUE.Equipment.Name"}}</th>
              <th>{{localize "ANTIQUE.Equipment.Quantity"}}</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {{#each equipment as |equip|}}
            <tr class="item" data-item-id="{{equip.id}}">
              <td>{{equip.name}}</td>
              <td class="quantity-cell">
                <span class="quantity-value {{#if (lt equip.system.quantity 1)}}empty{{/if}}">{{equip.system.quantity}}</span>
                {{#if equip.system.consumable}}
                <a class="item-consume" title="{{localize 'ANTIQUE.Consume.Use'}}"><i class="fas fa-flask"></i></a>
                {{/if}}
              </td>
              <td class="item-controls">
                <a class="item-edit"><i class="fas fa-edit"></i></a>
                <a class="item-delete"><i class="fas fa-trash"></i></a>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>

      <div class="equipment-section">
        <h2>{{localize "ANTIQUE.Inventory.Treasures"}}
          <a class="item-create" data-type="treasure" title="{{localize 'ANTIQUE.Item.Create'}}"><i class="fas fa-plus"></i></a>
        </h2>
        <table class="item-list">
          <thead>
            <tr>
              <th>{{localize "ANTIQUE.Equipment.Name"}}</th>
              <th>{{localize "ANTIQUE.Equipment.Quantity"}}</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {{#each treasures as |treasure|}}
            <tr class="item" data-item-id="{{treasure.id}}">
              <td>{{treasure.name}}</td>
              <td class="quantity-cell">
                <span class="quantity-value {{#if (lt treasure.system.quantity 1)}}empty{{/if}}">{{treasure.system.quantity}}</span>
              </td>
              <td class="item-controls">
                <a class="item-edit"><i class="fas fa-edit"></i></a>
                <a class="item-delete"><i class="fas fa-trash"></i></a>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
    {{!-- ===================== MAGIC TAB ===================== --}}
    {{#if system.isMagicPractitioner}}
    <div class="tab" data-group="primary" data-tab="magic">
      <div class="traits-section">
        <h2>{{localize "ANTIQUE.Traits.SpellsInstant"}}
          <a class="item-create" data-type="spell" title="{{localize 'ANTIQUE.Item.Create'}}"><i class="fas fa-plus"></i></a>
        </h2>
        <table class="item-list traits-table spells-table">
          <thead>
            <tr>
              <th class="trait-img-col"></th>
              <th>{{localize "ANTIQUE.Weapon.Name"}}</th>
              <th>{{localize "ANTIQUE.Spell.Effect"}}</th>
              <th>{{localize "ANTIQUE.Spell.Cost"}}</th>
              <th>{{localize "ANTIQUE.Spell.Duration"}}</th>
              <th>{{localize "ANTIQUE.Spell.Limitation"}}</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {{#each instantSpells as |spell|}}
            <tr class="item" data-item-id="{{spell.id}}">
              <td class="trait-img item-chat" title="{{localize 'ANTIQUE.Item.PostToChat'}}"><img src="{{spell.img}}" width="24" height="24" /></td>
              <td class="trait-name spell-chat clickable">{{spell.name}}</td>
              <td class="spell-effect">{{spell.effect}}</td>
              <td class="spell-cost">{{#if spell.cost}}{{spell.cost}} PM{{/if}}</td>
              <td class="spell-duration">{{spell.duration}}</td>
              <td class="spell-limitation">
                {{#if (gt spell.limitation 0)}}
                  <span class="limitation-value {{#if (lt spell.limitationValue 1)}}empty{{/if}}">{{spell.limitationValue}} / {{spell.limitation}}</span>
                {{else}}
                  <span class="limitation-unlimited">&infin;</span>
                {{/if}}
              </td>
              <td class="item-controls">
                <a class="spell-cast-btn" title="{{localize 'ANTIQUE.Spell.CastButton'}}"><i class="fas fa-hand-sparkles"></i> {{localize "ANTIQUE.Spell.CastButton"}}</a>
                <a class="item-edit"><i class="fas fa-edit"></i></a>
                <a class="item-delete"><i class="fas fa-trash"></i></a>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>

      <div class="traits-section">
        <h2>{{localize "ANTIQUE.Traits.SpellsRitual"}}
          <a class="item-create" data-type="spell" data-ritual="true" title="{{localize 'ANTIQUE.Item.Create'}}"><i class="fas fa-plus"></i></a>
        </h2>
        <table class="item-list traits-table spells-table">
          <thead>
            <tr>
              <th class="trait-img-col"></th>
              <th>{{localize "ANTIQUE.Weapon.Name"}}</th>
              <th>{{localize "ANTIQUE.Spell.Effect"}}</th>
              <th>{{localize "ANTIQUE.Spell.Cost"}}</th>
              <th>{{localize "ANTIQUE.Spell.Duration"}}</th>
              <th>{{localize "ANTIQUE.Spell.Limitation"}}</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {{#each ritualSpells as |spell|}}
            <tr class="item" data-item-id="{{spell.id}}">
              <td class="trait-img item-chat" title="{{localize 'ANTIQUE.Item.PostToChat'}}"><img src="{{spell.img}}" width="24" height="24" /></td>
              <td class="trait-name spell-chat clickable">{{spell.name}}</td>
              <td class="spell-effect">{{spell.effect}}</td>
              <td class="spell-cost">
                <span class="spell-cost-ingredients" title="{{spell.costText}}"><i class="fas fa-mortar-pestle"></i> {{spell.costText}}</span>
              </td>
              <td class="spell-duration">{{spell.duration}}</td>
              <td class="spell-limitation">
                {{#if (gt spell.limitation 0)}}
                  <span class="limitation-value {{#if (lt spell.limitationValue 1)}}empty{{/if}}">{{spell.limitationValue}} / {{spell.limitation}}</span>
                {{else}}
                  <span class="limitation-unlimited">&infin;</span>
                {{/if}}
              </td>
              <td class="item-controls">
                <a class="spell-cast-btn" title="{{localize 'ANTIQUE.Spell.CastButton'}}"><i class="fas fa-hand-sparkles"></i> {{localize "ANTIQUE.Spell.CastButton"}}</a>
                <a class="item-edit"><i class="fas fa-edit"></i></a>
                <a class="item-delete"><i class="fas fa-trash"></i></a>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
    {{/if}}
    {{/if}}

    {{!-- ===================== NOTES TAB ===================== --}}
    <div class="tab" data-group="primary" data-tab="notes">
      {{#if isGM}}
      <div class="bg-field bg-magic-practitioner">
        <label>
          <input type="checkbox" name="system.isMagicPractitioner" {{#if system.isMagicPractitioner}}checked{{/if}} />
          {{localize "ANTIQUE.Magic.Practitioner"}}
        </label>
      </div>
      {{/if}}
      <div class="player-notes-section">
        <h3><i class="fas fa-eye"></i> {{localize "ANTIQUE.PlayerNotes.Title"}}</h3>
        <div class="npc-notes">
          {{richEditor "system.notes" system.notes editable=isEditable}}
        </div>
      </div>
      {{#if isGM}}
      <div class="gm-notes-section">
        <h3><i class="fas fa-eye-slash"></i> {{localize "ANTIQUE.GmNotes.Title"}}</h3>
        <div class="gm-notes-editor">
          {{richEditor "system.gmNotes" system.gmNotes editable=isEditable}}
        </div>
      </div>
      {{/if}}
    </div>

  </section>
</div>
