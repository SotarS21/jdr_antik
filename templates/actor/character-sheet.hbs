<div class="antique sheet actor character">

  <div class="band"></div>

  {{!-- Header: Name, Portrait, PV --}}
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" data-action="editImage" title="{{actor.name}}" />
    <div class="header-fields">
      <h1 class="charname">
        <input name="name" type="text" value="{{actor.name}}" placeholder="Nom du personnage" />
      </h1>
      <div class="header-row">
        <div class="field">
          <label>{{localize "ANTIQUE.Identity.Devotion"}}</label>
          <input type="text" name="system.devotion" value="{{system.devotion}}" />
        </div>
        <div class="field">
          <label>{{localize "ANTIQUE.Identity.Joueur"}}</label>
          <input type="text" name="system.joueur" value="{{system.joueur}}" />
        </div>
      </div>
      <div class="header-stats">
        <div class="pv-bar">
          <label>{{localize "ANTIQUE.PV"}}</label>
          <input type="number" name="system.pv.value" value="{{pvSource.value}}" class="pv-current" />
          <span>/</span>
          <input type="number" name="system.pv.max" value="{{pvSource.max}}" class="pv-max" />
          <a class="long-rest" title="{{localize 'ANTIQUE.Rest.LongRest'}}"><i class="fas fa-campground"></i></a>
        </div>
        {{#if system.isMagicPractitioner}}
        <div class="pm-bar">
          <label>{{localize "ANTIQUE.PM"}}</label>
          <input type="number" name="system.pm.value" value="{{pmSource.value}}" class="pm-current" />
          <span>/</span>
          <input type="number" name="system.pm.max" value="{{pmSource.max}}" class="pm-max" />
        </div>
        {{/if}}
        <div class="ca-badge" title="{{localize 'ANTIQUE.Combat.CA'}}">
          <label>CA</label>
          <span class="ca-badge-value">{{system.ca.total}}</span>
        </div>
        <div class="avantage-temp-badge {{#if system.avantageTemporaire}}active{{/if}}" title="{{localize 'ANTIQUE.Traits.AvantageTemporaireInfo'}}">
          <img src="icons/svg/angel.svg" width="16" height="16" />
          <span>{{localize "ANTIQUE.Traits.AvantageTemporaire"}}</span>
        </div>
      </div>
      {{#if hasTraits}}
      <div class="header-traits">
        {{#each advantages as |adv|}}
        <div class="header-trait-icon advantage" data-item-id="{{adv.id}}" data-tooltip-name="{{adv.name}}" data-tooltip-effect="{{adv.effect}}">
          <img src="{{adv.img}}" width="20" height="20" />
        </div>
        {{/each}}
        {{#if hasBothTraits}}<span class="header-traits-sep"></span>{{/if}}
        {{#each disadvantages as |dis|}}
        <div class="header-trait-icon disadvantage" data-item-id="{{dis.id}}" data-tooltip-name="{{dis.name}}" data-tooltip-effect="{{dis.effect}}">
          <img src="{{dis.img}}" width="20" height="20" />
        </div>
        {{/each}}
      </div>
      {{/if}}
    </div>
  </header>

  {{!-- Navigation Tabs --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="identity">{{localize "ANTIQUE.Tab.Identity"}}</a>
    <a class="item" data-tab="abilities">{{localize "ANTIQUE.Tab.Abilities"}}</a>
    <a class="item" data-tab="combat">{{localize "ANTIQUE.Tab.Combat"}}</a>
    <a class="item" data-tab="inventory">{{localize "ANTIQUE.Tab.Inventory"}}</a>
    <a class="item" data-tab="traits">{{localize "ANTIQUE.Tab.Traits"}}</a>
    {{#if system.isMagicPractitioner}}
    <a class="item" data-tab="magic">{{localize "ANTIQUE.Tab.Magic"}}</a>
    {{/if}}
    {{#if system.hasIngredientBag}}
    <a class="item" data-tab="apothicaire">{{localize "ANTIQUE.Tab.Apothicaire"}}</a>
    {{/if}}
    <a class="item" data-tab="background">{{localize "ANTIQUE.Tab.Background"}}</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- ===================== IDENTITY TAB ===================== --}}
    <div class="tab" data-group="primary" data-tab="identity">
      <div class="identity-grid">
        <div class="field">
          <label>{{localize "ANTIQUE.Identity.Cite"}}</label>
          <input type="text" name="system.cite" value="{{system.cite}}" />
        </div>
        <div class="field">
          <label>{{localize "ANTIQUE.Identity.Age"}}</label>
          <input type="number" name="system.age" value="{{system.age}}" />
        </div>
        <div class="field">
          <label>{{localize "ANTIQUE.Identity.Yeux"}}</label>
          <input type="text" name="system.yeux" value="{{system.yeux}}" />
        </div>
        <div class="field">
          <label>{{localize "ANTIQUE.Identity.Peaux"}}</label>
          <input type="text" name="system.peaux" value="{{system.peaux}}" />
        </div>
        <div class="field">
          <label>{{localize "ANTIQUE.Identity.Cheveux"}}</label>
          <input type="text" name="system.cheveux" value="{{system.cheveux}}" />
        </div>
        <div class="field">
          <label>{{localize "ANTIQUE.Identity.Pilosite"}}</label>
          <input type="text" name="system.pilosite" value="{{system.pilosite}}" />
        </div>
        <div class="field">
          <label>{{localize "ANTIQUE.Identity.Taille"}}</label>
          <input type="text" name="system.taille" value="{{system.taille}}" />
        </div>
        <div class="field">
          <label>{{localize "ANTIQUE.Identity.Poid"}}</label>
          <input type="text" name="system.poid" value="{{system.poid}}" />
        </div>
        <div class="field">
          <label>{{localize "ANTIQUE.Identity.Sexe"}}</label>
          <input type="text" name="system.sexe" value="{{system.sexe}}" />
        </div>
        <div class="field">
          <label>{{localize "ANTIQUE.Identity.Deplacement"}}</label>
          <div class="input-with-suffix">
            <input type="number" name="system.deplacement" value="{{system.deplacement}}" />
            <span class="field-suffix">m</span>
          </div>
        </div>
        <div class="field">
          <label>{{localize "ANTIQUE.Identity.CapacitePort"}}</label>
          <div class="input-with-suffix">
            <input type="number" name="system.capacitePort" value="{{system.capacitePort}}" />
            <span class="field-suffix">kg</span>
          </div>
        </div>
      </div>
      <div class="historique-section">
        <label>{{localize "ANTIQUE.Identity.Historique"}}</label>
        <textarea name="system.historique" rows="4">{{system.historique}}</textarea>
      </div>
    </div>

    {{!-- ===================== ABILITIES + SKILLS TAB (D&D 5e style) ===================== --}}
    <div class="tab" data-group="primary" data-tab="abilities">

      {{!-- Favorites Bar: stable wrapper so _refreshFavoritesBar() (actor-sheet.mjs) always
           has an element to target, even when there are 0 favorites and the partial renders
           nothing inside it. --}}
      <div class="favorites-bar-container">
        {{> "systems/antique/templates/actor/parts/favorites-bar.hbs"}}
      </div>

      <div class="skills-search-bar">
        <i class="fas fa-search"></i>
        <input type="text" class="skill-search-input" placeholder="{{localize 'ANTIQUE.Skill.SearchPlaceholder'}}" />
      </div>

      <div class="abilities-skills-layout">

        {{!-- Left sidebar: Abilities --}}
        <div class="abilities-sidebar">
          {{#each system.abilities as |ability key|}}
          <div class="ability-block ability-{{key}}">
            <h3 class="ability-label ability-roll" data-ability="{{key}}">
              {{lookup @root.abilityLabels key}}
            </h3>
            <div class="ability-mod">
              <span class="ability-mod-value">{{signedNum ability.mod}}</span>
            </div>
            <div class="ability-score">
              <input type="number" name="system.abilities.{{key}}.value" value="{{ability.value}}" />
            </div>
          </div>
          {{/each}}
        </div>

        {{!-- Right area: Skills --}}
        <div class="skills-panel">
          {{#each skillsByAbility as |skills abilityKey|}}
          <div class="skill-group skill-group-{{abilityKey}}">
            <h3 class="skill-group-title">{{lookup @root.abilityLabels abilityKey}}</h3>
            <ul class="skill-list">
              {{#each skills as |skill key|}}
              <li class="skill-row {{#if skill.trained}}trained{{/if}} {{#if skill.isFavorite}}favorite{{/if}}">
                <button type="button" class="skill-trained" data-skill="{{skill.key}}" data-action="toggleSkillTrained"></button>
                {{#if skill.icon}}<i class="skill-icon {{skill.icon}}"></i>{{/if}}
                <span class="skill-name skill-roll" data-skill="{{skill.key}}" draggable="true" title="{{localize 'ANTIQUE.Macro.DragToHotbarHint'}}">{{skill.labelLocalized}}</span>
                {{#if skill.isFavorite}}<i class="fas fa-star skill-fav-star"></i>{{/if}}
                <input type="number" class="skill-bonus-input" name="system.skills.{{skill.key}}.bonus" data-skill="{{skill.key}}" value="{{skill.bonus}}" title="Bonus" />
                <span class="skill-total computed total">{{signedNum skill.total}}</span>
              </li>
              {{/each}}
            </ul>
          </div>
          {{/each}}
        </div>

      </div>

      {{!-- Saves row: less used, kept at the bottom of the tab --}}
      <div class="saves-row">
        <h3 class="saves-row-title">{{localize "ANTIQUE.Saves.Title"}}</h3>
        <div class="saves-row-items">
          {{#each savesData as |save key|}}
          <div class="save-card" title="{{save.tooltip}}">
            <span class="save-label save-roll" data-save="{{save.key}}">{{save.label}}</span>
            <div class="save-inputs">
              <label class="save-temp-label">{{localize 'ANTIQUE.Saves.Temp'}}</label>
              <input type="number" name="system.saves.{{save.key}}.temp" value="{{save.tempSource}}" />
            </div>
            <span class="save-total computed total">{{signedNum save.total}}</span>
          </div>
          {{/each}}
        </div>
      </div>
    </div>

    {{!-- ===================== COMBAT TAB ===================== --}}
    <div class="tab" data-group="primary" data-tab="combat">
      <div class="combat-stats">
        {{!-- CA --}}
        <div class="ca-section" title="{{caTooltip}}">
          <h2>{{localize "ANTIQUE.Combat.CA"}}</h2>
          <div class="ca-total">{{system.ca.total}}</div>
          <div class="ca-details">
            <div class="field">
              <label>{{localize "ANTIQUE.Combat.Temp"}}</label>
              <input type="number" name="system.ca.temp" value="{{caTempSource}}" />
            </div>
          </div>
        </div>

        {{!-- Initiative --}}
        <div class="initiative-section initiative-roll" title="Lancer l'initiative (1d20 {{signedNum system.initiative}})">
          <h2><i class="fas fa-dice-d20"></i> {{localize "ANTIQUE.Combat.Initiative"}}</h2>
          <div class="initiative-total">{{signedNum system.initiative}}</div>
          <div class="initiative-formula-hint">{{localize "ANTIQUE.Combat.InitiativeFormula"}}</div>
        </div>

        {{!-- Movement --}}
        <div class="deplacement-section">
          <h2><i class="fas fa-shoe-prints"></i> {{localize "ANTIQUE.Identity.Deplacement"}}</h2>
          <div class="deplacement-total">{{system.deplacement}} m</div>
        </div>

        {{!-- Esquive/Parade: reactive rolls, -1 temp penalty per use (stacks this
             turn), reset at the start of this actor's next turn (dodge-reset.mjs) --}}
        <div class="dodge-section dodge-roll" data-skill="esquive" title="{{localize 'ANTIQUE.Dodge.Hint'}}">
          <h2><i class="fas fa-running"></i> {{localize "ANTIQUE.Skill.Esquive"}}</h2>
          <div class="dodge-total">{{signedNum system.skills.esquive.total}}</div>
        </div>
        <div class="dodge-section dodge-roll" data-skill="parade" title="{{localize 'ANTIQUE.Dodge.Hint'}}">
          <h2><i class="fas fa-shield-alt"></i> {{localize "ANTIQUE.Skill.Parade"}}</h2>
          <div class="dodge-total">{{signedNum system.skills.parade.total}}</div>
        </div>
      </div>

      {{!-- Attack Bonuses --}}
      <div class="attack-bonuses">
        <h2>{{localize "ANTIQUE.Combat.AttackBonuses"}}</h2>
        <table class="attack-table">
          <thead>
            <tr>
              <th>{{localize "ANTIQUE.Combat.Category"}}</th>
              <th>{{localize "ANTIQUE.Combat.AbilityMod"}}</th>
              <th>{{localize "ANTIQUE.Combat.SkillBonus"}}</th>
              <th>{{localize "ANTIQUE.Saves.Total"}}</th>
            </tr>
          </thead>
          <tbody>
            {{#each weaponCatsData as |cat key|}}
            <tr>
              <td class="clickable attack-cat-roll" data-cat="{{cat.key}}">{{#if cat.icon}}<i class="{{cat.icon}}"></i> {{/if}}{{cat.label}}</td>
              <td class="computed ability-mod-cell {{#unless cat.trained}}inactive{{/unless}}" title="{{#unless cat.trained}}{{localize 'ANTIQUE.Combat.AbilityModUntrained'}}{{/unless}}">{{cat.abilityLabel}} {{signedNum cat.abilityMod}}</td>
              <td class="computed">{{signedNum cat.skillBonus}}</td>
              <td class="computed total">{{signedNum cat.total}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>

      {{!-- Weapons List --}}
      <div class="weapons-section">
        <h2>{{localize "ANTIQUE.Combat.Weapons"}}
          <a class="item-create" data-type="weapon" title="{{localize 'ANTIQUE.Item.Create'}}"><i class="fas fa-plus"></i></a>
        </h2>
        <table class="item-list weapons-list">
          <thead>
            <tr>
              <th class="weapon-img-col"></th>
              <th>{{localize "ANTIQUE.Weapon.Name"}}</th>
              <th>{{localize "ANTIQUE.Weapon.AttBonus"}}</th>
              <th>{{localize "ANTIQUE.Weapon.AttBonusDistance"}}</th>
              <th>{{localize "ANTIQUE.Weapon.Damage"}}</th>
              <th>{{localize "ANTIQUE.Weapon.Critical"}}</th>
              <th>{{localize "ANTIQUE.Weapon.Type"}}</th>
              <th>{{localize "ANTIQUE.Weapon.Portee"}}</th>
              <th>{{localize "ANTIQUE.Item.Consumable"}}</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {{#each weapons as |weapon|}}
            <tr class="item" data-item-id="{{weapon.id}}">
              <td class="weapon-img"><img src="{{weapon.img}}" width="24" height="24" /></td>
              <td class="weapon-name clickable weapon-attack">{{weapon.name}}</td>
              <td class="clickable weapon-attack">{{weapon.attTotal}}</td>
              <td class="clickable weapon-attack">{{#if weapon.system.hasPortee}}{{weapon.attTotalDistance}}{{else}}—{{/if}}</td>
              <td class="clickable weapon-damage">{{weapon.system.damage}}</td>
              <td>{{weapon.system.critical}}</td>
              <td>{{weapon.system.typeDamage}}</td>
              <td>{{#if weapon.system.hasPortee}}{{weapon.system.portee}} m{{else}}—{{/if}}</td>
              <td class="munitions-cell">
                {{#if weapon.system.consumable}}
                  {{#if weapon.linkedAmmoName}}
                  <span class="linked-ammo-badge" title="{{weapon.linkedAmmoName}}">
                    <i class="fas fa-link"></i>
                    <span class="munitions-value {{#if (lt weapon.linkedAmmoQty 1)}}empty{{/if}}">{{weapon.linkedAmmoQty}}</span>
                    <span class="linked-ammo-name">{{weapon.linkedAmmoName}}</span>
                  </span>
                  {{else}}
                  <select class="munitions-select">
                    <option value="">{{localize "ANTIQUE.Munitions.Choose"}}</option>
                    {{#each ../ammoCandidates as |ammo|}}
                    <option value="{{ammo.id}}">{{ammo.name}}</option>
                    {{/each}}
                  </select>
                  {{/if}}
                  <a class="item-consume" title="{{localize 'ANTIQUE.Consume.Munition'}}"><i class="fas fa-arrow-down"></i></a>
                {{else}}
                —
                {{/if}}
              </td>
              <td class="item-controls">
                <a class="item-edit" title="Edit"><i class="fas fa-edit"></i></a>
                <a class="item-delete" title="Delete"><i class="fas fa-trash"></i></a>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>

    {{!-- ===================== INVENTORY TAB ===================== --}}
    <div class="tab" data-group="primary" data-tab="inventory">
      <div class="currency-section">
        <label>{{localize "ANTIQUE.Currency.Or"}}</label>
        <input type="number" name="system.or" value="{{system.or}}" />
      </div>

      {{!-- Carry Weight Banner --}}
      <div class="trait-balance carry-weight-banner {{#if overCapacity}}unbalanced{{else}}balanced{{/if}}">
        <span class="trait-balance-label">{{localize "ANTIQUE.Inventory.CarryWeight"}} :</span>
        <span class="trait-balance-value">{{poidsPorteTotal}} / {{capacitePortTotal}} kg</span>
        {{#if overCapacity}}
          <span class="trait-balance-status"><i class="fas fa-exclamation-triangle"></i> {{localize "ANTIQUE.Inventory.OverCapacity"}}</span>
        {{/if}}
      </div>

      <div class="inventory-layout">
        <div class="equipment-section">
          <h2>{{localize "ANTIQUE.Inventory.Equipment"}}
            <a class="item-create" data-type="equipment" title="{{localize 'ANTIQUE.Item.Create'}}"><i class="fas fa-plus"></i> {{localize "ANTIQUE.Inventory.Equipment"}}</a>
            <a class="item-create" data-type="weapon" title="{{localize 'ANTIQUE.Item.Create'}}"><i class="fas fa-plus"></i> {{localize "ANTIQUE.Combat.Weapons"}}</a>
          </h2>
          <table class="item-list">
            <thead>
              <tr>
                <th class="equip-img-col"></th>
                <th>{{localize "ANTIQUE.Equipment.Name"}}</th>
                <th>{{localize "ANTIQUE.Equipment.Quantity"}}</th>
                <th>{{localize "ANTIQUE.Equipment.Price"}}</th>
                <th>{{localize "ANTIQUE.Equipment.Poids"}}</th>
                <th>{{localize "ANTIQUE.Equipment.Equipped"}}</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {{#each inventoryItems as |equip|}}
            <tr class="item draggable equip-row" data-item-id="{{equip.id}}">
              <td class="equip-img item-chat" title="{{localize 'ANTIQUE.Item.PostToChat'}}"><img src="{{equip.img}}" width="24" height="24" /></td>
              <td class="equip-name-cell">
                <a class="equip-toggle"><i class="fas fa-caret-right equip-toggle-icon"></i></a>
                {{#ifEquals equip.kind "weapon"}}<i class="fas fa-khanda inventory-kind-icon" title="{{localize 'ANTIQUE.Combat.Weapons'}}"></i>{{/ifEquals}}
                {{#if equip.isIngredientBag}}<i class="fas fa-mortar-pestle inventory-kind-icon" title="{{localize 'ANTIQUE.Equipment.IsIngredientBag'}}"></i>{{/if}}
                <span class="equip-name">{{equip.name}}</span>
              </td>
              <td class="quantity-cell">
                {{#ifEquals equip.kind "equipment"}}
                <span class="quantity-value {{#if (lt equip.system.quantity 1)}}empty{{/if}}">{{equip.system.quantity}}</span>
                {{#if equip.system.consumable}}
                <a class="item-consume" title="{{localize 'ANTIQUE.Consume.Use'}}"><i class="fas fa-flask"></i></a>
                {{/if}}
                {{else}}
                —
                {{/ifEquals}}
              </td>
              <td class="price-cell">{{#if equip.system.price}}{{equip.system.price}}{{else}}—{{/if}}</td>
              <td class="poids-cell">{{#if equip.system.poids}}{{equip.system.poids}} kg{{else}}—{{/if}}</td>
              <td class="equip-btn-cell">
                {{#if equip.hasSlot}}
                <a class="item-equip-btn {{#if equip.system.equipped}}active{{/if}}" title="{{equip.slotLabel}}">
                  <i class="fas {{#if equip.system.equipped}}fa-check-square{{else}}fa-square{{/if}}"></i>
                </a>
                {{else}}
                <a class="item-equip-picker" data-item-id="{{equip.id}}" data-kind="{{equip.kind}}" title="{{localize 'ANTIQUE.Equipment.ChooseSlot'}}">
                  <i class="fas fa-plus-circle"></i>
                </a>
                {{/if}}
              </td>
              <td class="item-controls">
                <a class="item-edit" title="Edit"><i class="fas fa-edit"></i></a>
                <a class="item-delete" title="Delete"><i class="fas fa-trash"></i></a>
              </td>
            </tr>
            <tr class="equip-desc-row" data-item-id="{{equip.id}}" style="display:none;">
              <td colspan="7">
                <div class="equip-desc-content">{{{equip.system.description}}}</div>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
        </div>

        <div class="silhouette-column">
          <h2 class="silhouette-title">{{localize "ANTIQUE.Inventory.EquippedGear"}}</h2>
          <div class="equip-silhouette-panel">
            <i class="fas fa-person silhouette-figure"></i>
            {{#each slotsData as |slot|}}
            <div class="equip-slot slot-{{slot.key}} {{#if slot.item}}filled{{else}}empty{{/if}}"
                 data-slot="{{slot.key}}" data-item-id="{{slot.item.id}}" title="{{slot.label}}{{#if slot.item}} — {{slot.item.name}}{{/if}}">
              {{#if slot.item}}
                <img src="{{slot.item.img}}" />
                {{#if slot.bonusLabel}}<span class="equip-slot-bonus">{{slot.bonusLabel}}</span>{{/if}}
                <a class="equip-slot-unequip" title="{{localize 'ANTIQUE.Equipment.Unequip'}}"><i class="fas fa-times"></i></a>
              {{else}}
                <i class="{{slot.icon}} equip-slot-placeholder"></i>
              {{/if}}
              <span class="equip-slot-label">{{slot.label}}</span>
            </div>
            {{/each}}
          </div>
        </div>
      </div>
    </div>

    {{!-- ===================== TRAITS TAB ===================== --}}
    <div class="tab" data-group="primary" data-tab="traits">

      {{!-- Trait Balance Banner --}}
      <div class="trait-balance {{#if traitBalanced}}balanced{{else}}unbalanced{{/if}}">
        <span class="trait-balance-label">{{localize "ANTIQUE.Traits.Balance"}} :</span>
        <span class="trait-balance-value">{{signedNum traitBalance}}</span>
        {{#if traitBalanced}}
          <span class="trait-balance-status"><i class="fas fa-check-circle"></i> {{localize "ANTIQUE.Traits.Balanced"}}</span>
        {{else}}
          <span class="trait-balance-status"><i class="fas fa-exclamation-triangle"></i> {{localize "ANTIQUE.Traits.Unbalanced"}}</span>
        {{/if}}
      </div>

      {{!-- Advantages (cout negatif) --}}
      <div class="traits-section">
        <h2>{{localize "ANTIQUE.Traits.Advantages"}}
          <a class="item-create" data-type="advantage" title="{{localize 'ANTIQUE.Item.Create'}}"><i class="fas fa-plus"></i></a>
        </h2>
        <table class="item-list traits-table">
          <thead>
            <tr>
              <th class="trait-img-col"></th>
              <th>{{localize "ANTIQUE.Traits.TraitName"}}</th>
              <th class="trait-cout-col">{{localize "ANTIQUE.Traits.Cout"}}</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {{#each advantages as |adv|}}
            <tr class="item trait-row" data-item-id="{{adv.id}}">
              <td class="trait-img item-chat" title="{{localize 'ANTIQUE.Item.PostToChat'}}"><img src="{{adv.img}}" width="24" height="24" /></td>
              <td class="trait-name"><i class="fas fa-caret-right trait-toggle-icon"></i> {{adv.name}}</td>
              <td class="trait-cout negative">{{adv.cout}}</td>
              <td class="item-controls">
                <a class="item-edit"><i class="fas fa-edit"></i></a>
                <a class="item-delete"><i class="fas fa-trash"></i></a>
              </td>
            </tr>
            <tr class="trait-detail-row" data-item-id="{{adv.id}}">
              <td colspan="4">
                <div class="trait-detail-content">
                  {{{adv.system.description}}}
                  {{#if adv.hasEffects}}
                  <div class="trait-effects-list"><strong>{{localize "ANTIQUE.Traits.Effect"}} :</strong> {{adv.effectsSummary}}</div>
                  {{/if}}
                  {{#if (gt adv.system.limitation 0)}}
                  <div class="trait-charges" data-item-id="{{adv.id}}">
                    <span class="limitation-counter">{{adv.system.limitationValue}} / {{adv.system.limitation}}</span>
                    <button type="button" class="advantage-use-charge"><i class="fas fa-dice"></i> {{localize "ANTIQUE.Traits.UseCharge"}}</button>
                    <button type="button" class="advantage-reset-charges"><i class="fas fa-rotate"></i> {{localize "ANTIQUE.Traits.ResetCharges"}}</button>
                  </div>
                  {{/if}}
                </div>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>

      {{!-- Disadvantages (cout positif) --}}
      <div class="traits-section">
        <h2>{{localize "ANTIQUE.Traits.Disadvantages"}}
          <a class="item-create" data-type="disadvantage" title="{{localize 'ANTIQUE.Item.Create'}}"><i class="fas fa-plus"></i></a>
        </h2>
        <table class="item-list traits-table">
          <thead>
            <tr>
              <th class="trait-img-col"></th>
              <th>{{localize "ANTIQUE.Traits.TraitName"}}</th>
              <th class="trait-cout-col">{{localize "ANTIQUE.Traits.Cout"}}</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {{#each disadvantages as |dis|}}
            <tr class="item trait-row" data-item-id="{{dis.id}}">
              <td class="trait-img item-chat" title="{{localize 'ANTIQUE.Item.PostToChat'}}"><img src="{{dis.img}}" width="24" height="24" /></td>
              <td class="trait-name"><i class="fas fa-caret-right trait-toggle-icon"></i> {{dis.name}}</td>
              <td class="trait-cout positive">{{signedNum dis.cout}}</td>
              <td class="item-controls">
                <a class="item-edit"><i class="fas fa-edit"></i></a>
                <a class="item-delete"><i class="fas fa-trash"></i></a>
              </td>
            </tr>
            <tr class="trait-detail-row" data-item-id="{{dis.id}}">
              <td colspan="4">
                <div class="trait-detail-content">
                  {{{dis.system.description}}}
                  {{#if dis.hasEffects}}
                  <div class="trait-effects-list"><strong>{{localize "ANTIQUE.Traits.Effect"}} :</strong> {{dis.effectsSummary}}</div>
                  {{/if}}
                </div>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>

      {{!-- Curses (Malédictions) --}}
      <div class="traits-section">
        <h2>{{localize "ANTIQUE.Traits.Curses"}}
          <a class="item-create" data-type="curse" title="{{localize 'ANTIQUE.Item.Create'}}"><i class="fas fa-plus"></i></a>
        </h2>
        <ul class="item-list traits-list">
          {{#each curses as |curse|}}
          <li class="item trait-row" data-item-id="{{curse.id}}">
            <img class="trait-list-img item-chat" src="{{curse.img}}" width="24" height="24" title="{{localize 'ANTIQUE.Item.PostToChat'}}" />
            <i class="fas fa-caret-right trait-toggle-icon"></i>
            <span class="trait-name">{{curse.name}}</span>
            {{#if curse.hasEffects}}
            <span class="effect-badge disadvantage" title="{{curse.effectsSummary}}">
              <i class="fas fa-skull-crossbones"></i>
            </span>
            {{/if}}
            <span class="item-controls">
              <a class="item-edit"><i class="fas fa-edit"></i></a>
              <a class="item-delete"><i class="fas fa-trash"></i></a>
            </span>
            <div class="trait-detail-content">
              {{{curse.system.description}}}
              {{#if curse.hasEffects}}
              <div class="trait-effects-list"><strong>{{localize "ANTIQUE.Traits.Effect"}} :</strong> {{curse.effectsSummary}}</div>
              {{/if}}
            </div>
          </li>
          {{/each}}
        </ul>
      </div>

      {{!-- Effets : de vrais ActiveEffect Foundry embarqués directement sur l'acteur
           (glissés depuis le compendium Effets, ou créés ici) — distincts d'un
           ActiveEffect qui vit sur un Avantage/Désavantage possédé (transféré,
           montré dans l'accordéon de ce trait, pas ici). Éditer ouvre la fiche
           native Foundry de l'ActiveEffect — aucune fiche personnalisée requise. --}}
      <div class="traits-section">
        <h2>{{localize "ANTIQUE.Traits.Effects"}}
          <a class="actor-effect-create" title="{{localize 'ANTIQUE.Effects.Add'}}"><i class="fas fa-plus"></i></a>
        </h2>
        <ul class="item-list traits-list">
          {{#each effects as |eff|}}
          <li class="item trait-row {{#if eff.disabled}}disabled{{/if}}" data-effect-id="{{eff.id}}">
            <img class="trait-list-img" src="{{eff.img}}" width="24" height="24" />
            <i class="fas fa-caret-right trait-toggle-icon"></i>
            <span class="trait-name">{{eff.name}}</span>
            {{#if eff.hasEffects}}
            <span class="effect-badge condition" title="{{eff.effectsSummary}}">
              <i class="fas fa-sparkles"></i>
            </span>
            {{/if}}
            <span class="item-controls">
              <a class="actor-effect-toggle" title="{{#if eff.disabled}}{{localize 'ANTIQUE.Effects.Disabled'}}{{else}}{{localize 'ANTIQUE.Effects.Active'}}{{/if}}">
                <i class="fas {{#if eff.disabled}}fa-times-circle{{else}}fa-check-circle{{/if}}"></i>
              </a>
              <a class="actor-effect-edit"><i class="fas fa-edit"></i></a>
              <a class="actor-effect-delete"><i class="fas fa-trash"></i></a>
            </span>
            <div class="trait-detail-content">
              {{{eff.description}}}
              {{#if eff.hasEffects}}
              <div class="trait-effects-list"><strong>{{localize "ANTIQUE.Traits.Effect"}} :</strong> {{eff.effectsSummary}}</div>
              {{/if}}
            </div>
          </li>
          {{/each}}
        </ul>
      </div>

      {{!-- Blessings --}}
      <div class="traits-section">
        <h2>{{localize "ANTIQUE.Traits.Blessings"}}
          <a class="item-create" data-type="blessing" title="{{localize 'ANTIQUE.Item.Create'}}"><i class="fas fa-plus"></i></a>
        </h2>
        <ul class="item-list traits-list">
          {{#each blessings as |bless|}}
          <li class="item trait-row" data-item-id="{{bless.id}}">
            <img class="trait-list-img item-chat" src="{{bless.img}}" width="24" height="24" title="{{localize 'ANTIQUE.Item.PostToChat'}}" />
            <i class="fas fa-caret-right trait-toggle-icon"></i>
            <span class="trait-name">{{bless.name}}</span>
            {{#if bless.hasEffects}}
            <span class="effect-badge blessing" title="{{bless.effectsSummary}}">
              <i class="fas fa-magic"></i>
            </span>
            {{/if}}
            <span class="item-controls">
              <a class="item-edit"><i class="fas fa-edit"></i></a>
              <a class="item-delete"><i class="fas fa-trash"></i></a>
            </span>
            <div class="trait-detail-content">
              {{{bless.system.description}}}
              {{#if bless.hasEffects}}
              <div class="trait-effects-list"><strong>{{localize "ANTIQUE.Traits.Effect"}} :</strong> {{bless.effectsSummary}}</div>
              {{/if}}
            </div>
          </li>
          {{/each}}
        </ul>
      </div>

    </div>

    {{!-- ===================== MAGIC TAB ===================== --}}
    {{#if system.isMagicPractitioner}}
    <div class="tab" data-group="primary" data-tab="magic">
      <div class="traits-section">
        <h2>{{localize "ANTIQUE.Traits.SpellsInstant"}}
          <a class="item-create" data-type="spell" title="{{localize 'ANTIQUE.Item.Create'}}"><i class="fas fa-plus"></i></a>
        </h2>
        <table class="item-list traits-table spells-table">
          <thead>
            <tr>
              <th class="trait-img-col"></th>
              <th>{{localize "ANTIQUE.Weapon.Name"}}</th>
              <th>{{localize "ANTIQUE.Spell.Effect"}}</th>
              <th>{{localize "ANTIQUE.Spell.Cost"}}</th>
              <th>{{localize "ANTIQUE.Spell.Duration"}}</th>
              <th>{{localize "ANTIQUE.Spell.Limitation"}}</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {{#each instantSpells as |spell|}}
            <tr class="item" data-item-id="{{spell.id}}">
              <td class="trait-img item-chat" title="{{localize 'ANTIQUE.Item.PostToChat'}}"><img src="{{spell.img}}" width="24" height="24" /></td>
              <td class="trait-name spell-chat clickable">{{spell.name}}</td>
              <td class="spell-effect">{{spell.effect}}</td>
              <td class="spell-cost">{{#if spell.cost}}{{spell.cost}} PM{{/if}}</td>
              <td class="spell-duration">{{spell.duration}}</td>
              <td class="spell-limitation">
                {{#if (gt spell.limitation 0)}}
                  <span class="limitation-value {{#if (lt spell.limitationValue 1)}}empty{{/if}}">{{spell.limitationValue}} / {{spell.limitation}}</span>
                {{else}}
                  <span class="limitation-unlimited">&infin;</span>
                {{/if}}
              </td>
              <td class="item-controls">
                <a class="spell-cast-btn" title="{{localize 'ANTIQUE.Spell.CastButton'}}"><i class="fas fa-hand-sparkles"></i> {{localize "ANTIQUE.Spell.CastButton"}}</a>
                <a class="item-edit"><i class="fas fa-edit"></i></a>
                <a class="item-delete"><i class="fas fa-trash"></i></a>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>

      <div class="traits-section">
        <h2>{{localize "ANTIQUE.Traits.SpellsRitual"}}
          <a class="item-create" data-type="spell" data-ritual="true" title="{{localize 'ANTIQUE.Item.Create'}}"><i class="fas fa-plus"></i></a>
        </h2>
        <table class="item-list traits-table spells-table">
          <thead>
            <tr>
              <th class="trait-img-col"></th>
              <th>{{localize "ANTIQUE.Weapon.Name"}}</th>
              <th>{{localize "ANTIQUE.Spell.Effect"}}</th>
              <th>{{localize "ANTIQUE.Spell.Cost"}}</th>
              <th>{{localize "ANTIQUE.Spell.Duration"}}</th>
              <th>{{localize "ANTIQUE.Spell.Limitation"}}</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {{#each ritualSpells as |spell|}}
            <tr class="item" data-item-id="{{spell.id}}">
              <td class="trait-img item-chat" title="{{localize 'ANTIQUE.Item.PostToChat'}}"><img src="{{spell.img}}" width="24" height="24" /></td>
              <td class="trait-name spell-chat clickable">{{spell.name}}</td>
              <td class="spell-effect">{{spell.effect}}</td>
              <td class="spell-cost">
                <span class="spell-cost-ingredients" title="{{spell.costText}}"><i class="fas fa-mortar-pestle"></i> {{spell.costText}}</span>
              </td>
              <td class="spell-duration">{{spell.duration}}</td>
              <td class="spell-limitation">
                {{#if (gt spell.limitation 0)}}
                  <span class="limitation-value {{#if (lt spell.limitationValue 1)}}empty{{/if}}">{{spell.limitationValue}} / {{spell.limitation}}</span>
                {{else}}
                  <span class="limitation-unlimited">&infin;</span>
                {{/if}}
              </td>
              <td class="item-controls">
                <a class="spell-cast-btn" title="{{localize 'ANTIQUE.Spell.CastButton'}}"><i class="fas fa-hand-sparkles"></i> {{localize "ANTIQUE.Spell.CastButton"}}</a>
                <a class="item-edit"><i class="fas fa-edit"></i></a>
                <a class="item-delete"><i class="fas fa-trash"></i></a>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
    {{/if}}

    {{!-- ===================== APOTHICAIRE TAB ===================== --}}
    <div class="tab" data-group="primary" data-tab="apothicaire">

      <div class="ingredient-search-bar">
        <i class="fas fa-search"></i>
        <input type="text" class="ingredient-search" placeholder="{{localize 'ANTIQUE.Apoth.SearchPlaceholder'}}" />
      </div>

      {{#each apothSections as |section|}}
      <div class="apoth-section">
        <h2>{{section.label}}
          <a class="item-create" data-type="equipment" data-apoth-category="{{section.key}}" title="{{localize 'ANTIQUE.Item.Create'}}"><i class="fas fa-plus"></i></a>
        </h2>
        {{#if section.items.length}}
        <table class="item-list apoth-table">
          <thead>
            <tr>
              <th class="equip-img-col"></th>
              <th>{{localize "ANTIQUE.Equipment.Name"}}</th>
              {{#unless section.isPotion}}<th>{{localize "ANTIQUE.Apoth.Type"}}</th>{{/unless}}
              <th>{{localize "ANTIQUE.Equipment.Price"}}</th>
              <th>{{localize "ANTIQUE.Equipment.Quantity"}}</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {{#each section.items as |ing|}}
            <tr class="item equip-row apoth-row {{#if (lt ing.system.quantity 1)}}apoth-row-empty{{/if}}" data-item-id="{{ing.id}}">
              <td class="equip-img"><img src="{{ing.img}}" width="24" height="24" /></td>
              <td class="equip-name-cell">
                <a class="equip-toggle"><i class="fas fa-caret-right equip-toggle-icon"></i></a>
                <span class="equip-name">{{ing.name}}</span>
              </td>
              {{#unless section.isPotion}}<td>{{ing.system.apothType}}</td>{{/unless}}
              <td class="price-cell">{{#if ing.system.price}}{{ing.system.price}}{{else}}—{{/if}}</td>
              <td class="quantity-cell">
                <span class="quantity-value {{#if (lt ing.system.quantity 1)}}empty{{/if}}">{{ing.system.quantity}}</span>
                <a class="ingredient-restock" title="{{localize 'ANTIQUE.Apoth.Restock'}}"><i class="fas fa-plus-circle"></i></a>
                {{#if ing.system.consumable}}
                <a class="item-consume" title="{{localize 'ANTIQUE.Consume.Use'}}"><i class="fas fa-flask"></i></a>
                {{/if}}
              </td>
              <td class="item-controls">
                <a class="item-edit" title="Edit"><i class="fas fa-edit"></i></a>
                <a class="item-delete" title="Delete"><i class="fas fa-trash"></i></a>
              </td>
            </tr>
            <tr class="equip-desc-row" data-item-id="{{ing.id}}" style="display:none;">
              <td colspan="6">
                <div class="equip-desc-content">{{{ing.system.description}}}</div>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
        {{else}}
        <p class="apoth-empty">{{localize "ANTIQUE.Apoth.Empty"}}</p>
        {{/if}}
      </div>
      {{/each}}
    </div>

    {{!-- ===================== BACKGROUND TAB ===================== --}}
    <div class="tab" data-group="primary" data-tab="background">
      <div class="background-grid">

        <div class="bg-field bg-magic-practitioner">
          <label>
            <input type="checkbox" name="system.isMagicPractitioner" {{#if system.isMagicPractitioner}}checked{{/if}} />
            {{localize "ANTIQUE.Magic.Practitioner"}}
          </label>
          <label>
            <input type="checkbox" name="system.hasIngredientBag" {{#if system.hasIngredientBag}}checked{{/if}} />
            {{localize "ANTIQUE.Apoth.HasBag"}}
          </label>
        </div>

        <div class="bg-field bg-histoire">
          <h3><i class="fas fa-scroll"></i> {{localize "ANTIQUE.Background.Histoire"}}</h3>
          {{richEditor "system.background.histoire" system.background.histoire editable=isEditable}}
        </div>

        {{> "systems/antique/templates/actor/parts/actor-ref-section.hbs"
            listKey="alliesList"
            icon="fas fa-handshake"
            titleKey="ANTIQUE.Background.Allies"
            grouped=alliesGrouped
            isEditable=isEditable }}

        {{> "systems/antique/templates/actor/parts/actor-ref-section.hbs"
            listKey="ennemisList"
            icon="fas fa-skull-crossbones"
            titleKey="ANTIQUE.Background.Ennemis"
            grouped=ennemisGrouped
            isEditable=isEditable }}

        <div class="bg-field bg-croyance">
          <h3><i class="fas fa-sun"></i> {{localize "ANTIQUE.Background.Croyance"}}
            {{#if isEditable}}<a class="bg-text-edit" data-field="croyance" data-title="ANTIQUE.Background.Croyance" title="{{localize 'ANTIQUE.Background.EditText'}}"><i class="fas fa-edit"></i></a>{{/if}}
          </h3>
          <div class="bg-text-preview">{{{enrichedCroyance}}}</div>
        </div>

        <div class="bg-field bg-aime">
          <h3><i class="fas fa-heart"></i> {{localize "ANTIQUE.Background.Aime"}}
            {{#if isEditable}}<a class="bg-text-edit" data-field="aime" data-title="ANTIQUE.Background.Aime" title="{{localize 'ANTIQUE.Background.EditText'}}"><i class="fas fa-edit"></i></a>{{/if}}
          </h3>
          <div class="bg-text-preview">{{{enrichedAime}}}</div>
        </div>

        <div class="bg-field bg-naime-pas">
          <h3><i class="fas fa-heart-broken"></i> {{localize "ANTIQUE.Background.NaimePas"}}
            {{#if isEditable}}<a class="bg-text-edit" data-field="naimePas" data-title="ANTIQUE.Background.NaimePas" title="{{localize 'ANTIQUE.Background.EditText'}}"><i class="fas fa-edit"></i></a>{{/if}}
          </h3>
          <div class="bg-text-preview">{{{enrichedNaimePas}}}</div>
        </div>

        <div class="bg-field bg-expressions">
          <h3><i class="fas fa-comment-dots"></i> {{localize "ANTIQUE.Background.Expressions"}}
            {{#if isEditable}}<a class="bg-text-edit" data-field="expressions" data-title="ANTIQUE.Background.Expressions" title="{{localize 'ANTIQUE.Background.EditText'}}"><i class="fas fa-edit"></i></a>{{/if}}
          </h3>
          <div class="bg-text-preview">{{{enrichedExpressions}}}</div>
        </div>

      </div>
    </div>

  </section>
</div>
